{
  "manifest_version": 3,
  "name": "YouTube Video Filter",
  "version": "0.2.0",
  "description": "YouTube動画へAnime4Kアップスケーリングとカラーレンジ変換をリアルタイムに適用します。",
  "minimum_chrome_version": "113",
  "icons": {
    "16": "design/icon.png",
    "32": "design/icon.png",
    "48": "design/icon.png",
    "128": "design/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Video Filter",
    "default_icon": {
      "16": "design/icon.png",
      "32": "design/icon.png"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_media_cors",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
